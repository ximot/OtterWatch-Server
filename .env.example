# OtterWatch Server Environment Variables

# API keys for agent authentication (comma-separated)
OTTERWATCH_API_KEYS=your-secret-api-key-here

# Public URL for agent update downloads
# This should be the externally accessible URL of the server
OTTERWATCH_PUBLIC_URL=http://your-server-ip:8080

# Log level (trace, debug, info, warn, error)
RUST_LOG=info
